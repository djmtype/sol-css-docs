---
import Layout from "@/layouts/Layout.astro"
import LogoAlpha from "@/components/Base/LogoAlpha.astro"
import { getCollection, type CollectionEntry } from "astro:content"

import Topographic from "@/components/Base/Topographic.astro"

const title = "Welcome"
const description = "A classless CSS library"

type Props = CollectionEntry<"docs">[]

const docsCollection = await getCollection("docs")

const docs = docsCollection
  .map((entry) => ({
    data: {
      ...entry.data,
      slug: entry.id
    },
    props: entry,
  }))
  .sort((a, b) => {
    // Extract the first part of each slug (e.g., 'getting-started')
    const firstPartA = a.data.slug.split("/")[0]
    const firstPartB = b.data.slug.split("/")[0]

    // Define the desired order of the sections
    const sectionOrder = ["getting-started", "elements", "components"]

    // Sort by the defined sectionOrder of sections
    const sectionComparison = sectionOrder.indexOf(firstPartA) - sectionOrder.indexOf(firstPartB)
    if (sectionComparison !== 0) {
      return sectionComparison
    }

    // If in the same section, sort by pageOrder in ascending order
    return (a.data.order || 0) - (b.data.order || 0)
  })

const groupedDocs = docs.reduce(
  (groups: Record<string, Props>, item: { data: any; props: CollectionEntry<"docs"> }) => {
    const firstPart = item.data.slug.split("/")[0]
    if (!groups[firstPart]) {
      groups[firstPart] = []
    }
    groups[firstPart].push(item.props) // Use item.props which is of type CollectionEntry<"docs">
    return groups
  },
  {} as Record<string, Props>,
)

function formatTitle(input: string): string {
  return input
    .split("-") // Split the string by hyphens
    .map((word) => {
      // Capitalize the first letter and make the rest lowercase
      return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()
    })
    .join(" ") // Join the words back with a space
}
---

<Layout title={title} description={description}>
  <Topographic />
  <section id="section-1">
    <header>
      <hgroup>
        <LogoAlpha style={{ justifySelf: "center" }} />

        <p style="font-size: var(--font-size-1); color: var(--color-ink-muted)"><em>CSS without the FUSS</em></p>
      </hgroup>
    </header>
    <div role="group"><a href="/docs" role="button">Get Started</a> <a href="/docs#usage">Using SOL</a></div>
  </section>

  <section id="section-2">
    <div class="wrapper">
      <h2>Contents</h2>
      <!-- Inside your .astro file (HTML section) -->
      <div class="contents">
        {
          Object.entries(groupedDocs).map(([group, items]) => (
            <>
              <h3>{formatTitle(group)}</h3>
              <div class="contents-grid">
                {items.map((item) => (
                  <div class="contents-card">
                    <h4>{item.data.title}</h4>
                    <p>{item.data.description}</p>
                    <a href={`/docs/${item.id}`}>View document</a>
                  </div>
                ))}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  :global(main) {
    flex: 1;
    display: grid;
    place-items: center;
  }

  #section-1 {
    inline-size: calc(100% - (var(--spacing-gutter) * 2));

    background: radial-gradient(closest-side, var(--color-surface) 25%, color-mix(in oklch, var(--color-accent), transparent 100%) 99%);
    display: grid;
    place-content: center;
    gap: var(--spacing-2xl);
    grid-template-columns: minmax(0, 1fr);
    align-self: center;
    margin: auto;
    text-align: center;
    /* inline-size: min(min(var(--breakpoint-lg), 100%), calc(100% - (var(--spacing-gutter) * 2))); */
  }

  #section-1 {
    min-height: calc(100svh - var(--header-height, 0));
    position: sticky;
    top: 0;
  }

  #section-2 {
    min-height: 100svh;
    width: 100%;
    background: var(--color-surface-bright);
    z-index: 2;
  }

  [role="group"] {
    display: flex;
    gap: var(--spacing-xs);
    place-content: center;
    place-items: center;
  }

  .contents-grid {
    display: grid;
    gap: var(--spacing-gutter);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30ch), 1fr));

}

.contents-card {
    display: grid; 
    grid-template-rows: auto 1fr auto;
    background: var(--color-surface);
    min-block-size: 30svh;
    gap: var(--spacing-sm);
    position: relative;




    > h4 {
      color: var(--color-gray-1);
      grid-row: 1;
      background: var(--color-accent);
      padding: var(--spacing-xs);
      /* padding-block-start: calc(var(--spacing-xs) + 2cqi); */
      align-self: baseline;

    }
    > p {
        grid-row: 2; 
        align-self: baseline;
        padding-inline: var(--spacing-xs);
        color: var(--color-ink-muted);
    }
    > a {
        grid-row: 3; 
        margin-block-start: auto;
        margin-block-end: 0;
        padding: var(--spacing-xs);
        position: static;
        &::before {
          content: "";
          position: absolute;
          width: 100%;
          height: 100%;
          inset: 0;
          display: block;
          z-index: 0;
user-select: none;
        }
    }
}




</style>
