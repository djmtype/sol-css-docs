---
import Layout from "@/layouts/Layout.astro"
import LogoEffect from "@/components/Base/LogoEffect.astro"

// import Topographic from "@/components/Base/Topographic.astro"

const title = "Welcome"
const description = "A classless CSS library"
---

<Layout title={title} description={description}>

  <section id="section-1">

      <hgroup>
        <LogoEffect style={{ justifySelf: "center" }} />

        <p style={{ fontSize: "var(--font-size-1)", color: "var(--color-ink-mute)" }}><em>CSS without the FUSS</em></p>
      </hgroup>

    <div role="group"><a href="/docs" role="button">Get Started</a> <a href="/docs/#usage">Using SOL</a></div>

  </section>
  <!-- <Topographic /> -->
</Layout>

<style>


  #section-1 {
    /* width: 100%;
    max-width: var(--breakpoint-lg);
    margin-inline: auto; */


    background: radial-gradient(closest-side, var(--color-surface) 25%, color-mix(in oklch, var(--color-accent), transparent 100%) 99%);
    display: grid;
    place-content: center;
    gap: var(--spacing-2xl);
    grid-template-columns: minmax(0, 1fr);
    /* align-self: center; */
    /* margin: auto; */
    text-align: center;
    inline-size: min(var(--breakpoint-lg), calc(100% - (var(--spacing-gutter) * 2)));
    margin-inline: auto;
    /* margin-block-start: calc(-1 * var(--header-height)); */


  }

  #section-1 hgroup {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sibling);
  > p {
    z-index: 2;
  }
  }



  #section-2 {
    min-height: 100svh;
    width: 100%;
    background: var(--color-surface-bright);
    z-index: 2;
  }

  [role="group"] {
    display: flex;
    gap: var(--spacing-xs);
    place-content: center;
    place-items: center;
  }

  .contents-grid {
    display: grid;
    gap: var(--spacing-gutter);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30ch), 1fr));
  }

  .contents-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--color-surface);
    min-block-size: 30svh;
    gap: var(--spacing-sm);
    position: relative;

    > h4 {
      color: var(--color-gray-1);
      grid-row: 1;
      background: var(--color-accent);
      padding: var(--spacing-xs);
      /* padding-block-start: calc(var(--spacing-xs) + 2cqi); */
      align-self: baseline;
    }
    > p {
      grid-row: 2;
      align-self: baseline;
      padding-inline: var(--spacing-xs);
      color: var(--color-ink-mute);
    }
    > a {
      grid-row: 3;
      margin-block-start: auto;
      margin-block-end: 0;
      padding: var(--spacing-xs);
      position: static;
      &::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        inset: 0;
        display: block;
        z-index: 0;
        user-select: none;
      }
    }
  }
</style>
