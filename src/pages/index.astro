---
import Layout from "@/layouts/Layout.astro"
import LogoAlpha from "@/components/Base/LogoAlpha.astro"


import Topographic from "@/components/Base/Topographic.astro"

const title = "Welcome"
const description = "A classless CSS library"



---

<Layout title={title} description={description} category="">
  <Topographic />
  <section id="section-1">
    <header>
      <hgroup>
        <LogoAlpha style={{ justifySelf: "center" }} />

        <p style="font-size: var(--font-size-1); color: var(--color-ink-muted)"><em>CSS without the FUSS</em></p>
      </hgroup>
    </header>
    <div role="group"><a href="/docs" role="button">Get Started</a> <a href="/docs#usage">Using SOL</a></div>
  </section>

  
</Layout>

<style>
  :global(main) {
    flex: 1;
    display: grid;
    place-items: center;
  }

  #section-1 {
    inline-size: calc(100% - (var(--spacing-gutter) * 2));

    background: radial-gradient(closest-side, var(--color-surface) 25%, color-mix(in oklch, var(--color-accent), transparent 100%) 99%);
    display: grid;
    place-content: center;
    gap: var(--spacing-2xl);
    grid-template-columns: minmax(0, 1fr);
    align-self: center;
    margin: auto;
    text-align: center;
    /* inline-size: min(min(var(--breakpoint-lg), 100%), calc(100% - (var(--spacing-gutter) * 2))); */
  }

  #section-1 {
    min-height: calc(100svh - var(--header-height, 0));
    position: sticky;
    top: 0;
  }

  #section-2 {
    min-height: 100svh;
    width: 100%;
    background: var(--color-surface-bright);
    z-index: 2;
  }

  [role="group"] {
    display: flex;
    gap: var(--spacing-xs);
    place-content: center;
    place-items: center;
  }

  .contents-grid {
    display: grid;
    gap: var(--spacing-gutter);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30ch), 1fr));

}

.contents-card {
    display: grid; 
    grid-template-rows: auto 1fr auto;
    background: var(--color-surface);
    min-block-size: 30svh;
    gap: var(--spacing-sm);
    position: relative;




    > h4 {
      color: var(--color-gray-1);
      grid-row: 1;
      background: var(--color-accent);
      padding: var(--spacing-xs);
      /* padding-block-start: calc(var(--spacing-xs) + 2cqi); */
      align-self: baseline;

    }
    > p {
        grid-row: 2; 
        align-self: baseline;
        padding-inline: var(--spacing-xs);
        color: var(--color-ink-muted);
    }
    > a {
        grid-row: 3; 
        margin-block-start: auto;
        margin-block-end: 0;
        padding: var(--spacing-xs);
        position: static;
        &::before {
          content: "";
          position: absolute;
          width: 100%;
          height: 100%;
          inset: 0;
          display: block;
          z-index: 0;
user-select: none;
        }
    }
}




</style>
