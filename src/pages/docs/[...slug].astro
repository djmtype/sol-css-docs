---
import "@/styles/layout/collections.css"
import "@/styles/utilities/prose.css"
import { slugify, titleCase } from "@/utils/global"
import FormattedDate from "@/components/Base/FormattedDate.astro"
import SideNav from "@/components/Base/SideNav.astro";


import { type CollectionEntry, getCollection } from "astro:content"
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro"


export async function getStaticPaths() {
  const docs = await getCollection("docs")
  return docs.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: entry,
  }))
}
type Props = CollectionEntry<"docs">

// const { currentPage } = Astro.props;
// const currentPage = Astro.url.pathname

const entry = Astro.props



const { Content, headings } = await render(entry)
---

<Layout headings={headings} {...entry.data}>
  <aside id="main-aside">
    <SideNav />
  </aside>
  <article class="main-article">
    <div class="prose">
      <hgroup>
        <p style={{ textTransform: 'uppercase', letterSpacing: '.04em', fontWeight: '600', color: 'var(--color-ink-primary)'}}>{titleCase(entry.data.category)}</p>
        <h1 id={slugify(entry.data.title)}>{entry.data.title}</h1>
        {entry.data.dateUpdated && (
          <p><span style={{ fontStyle: 'italic' }}>Last updated:</span> <FormattedDate date={entry.data.dateUpdated} /></p>
        )}
      </hgroup>
<hr />
      <Content />
    </div>
  </article>
</Layout>


