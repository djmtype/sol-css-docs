---
import "@/styles/layout/docs.css"
import "@/styles/utilities/prose.css"
import { slugify, titleCase } from "@/utils/global"
import FormattedDate from "@/components/Base/FormattedDate.astro"
import NavDocs from "@/components/Base/NavDocs.astro";


import { type CollectionEntry, getCollection } from "astro:content"
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro"


export async function getStaticPaths() {
  const docs = await getCollection("docs")
  return docs.map((entry) => ({
    params: {
      slug: entry.id,
    },
    props: entry,
  }))
}
type Props = CollectionEntry<"docs">

// const { currentPage } = Astro.props;
// const currentPage = Astro.url.pathname

const entry = Astro.props



const { Content, headings } = await render(entry)



const slideAnima = {
  old: {
    name: 'slideOut',
    duration: '.3s',
    easing: 'ease',
    fillMode: 'both',
  },
  new: {
    name: 'slideIn',
    duration: '.3s',
    delay: '0.15s',
    easing: 'ease',
    fillMode: 'both',
  },
}
const verticalSlide = {
  forwards: slideAnima,
  backwards: slideAnima,
}


---

<Layout headings={headings} {...entry.data}>
  <aside id="main-aside">
    <NavDocs />
  </aside>
  <article class="main-article" transition:animate={verticalSlide}>
    <div class="prose">
      <hgroup>
        <p style={{ textTransform: 'uppercase', letterSpacing: '.04em', fontWeight: '600', color: 'var(--color-ink-primary)'}}>{titleCase(entry.data.category)}</p>
        <h1 id={slugify(entry.data.title)}>{entry.data.title}</h1>
        {entry.data.dateUpdated && (
          <p><span style={{ fontStyle: 'italic' }}>Last updated:</span> <FormattedDate date={entry.data.dateUpdated} /></p>
        )}
      </hgroup>
<hr />
      <Content />
    </div>
  </article>
</Layout>

<style is:global>


@keyframes slideIn {
  from {
    translate: 25% 0%;
    opacity: 0;
  }
  to {
    opacity: 1;
    translate: 0% 0%;
  }
}
@keyframes slideOut {
  from {
    translate: 0% 0%;
    opacity: 1;
  }
  to {
    opacity: 0;
    translate: 25% 0%;
  }
}
</style>
