---
// Import CSS raw text using Vite's ?raw import parameter (no `fs` required)
import primaryCss from "sol-css/src/theme/palettes/palette.primary.css?raw";
import secondaryCss from "sol-css/src/theme/palettes/palette.secondary.css?raw";
import grayCss from "sol-css/src/theme/palettes/palette.gray.css?raw";

interface Swatch {
  name: string;
  value: string;
}

type SwatchCategories = Record<string, Swatch[]>;

/**
 * Extracts CSS custom properties from CSS stylesheet text.
 */
function extractCssVariables(cssStyles: string): SwatchCategories {
  // Capture blocks targeting :root, *, or similar standard selectors
  const styleBlockMatch = cssStyles.match(/(?::root|\*)\s*\{([^}]*)\}/s);

  if (!styleBlockMatch) {
    console.warn("No valid CSS variables root block found.");
    return {};
  }

  const styleBlockContents = styleBlockMatch[1];
  // Match CSS variable declaration line-by-line or by variable pattern
  const variableRegex = /--([^:\s]+)\s*:\s*([^;]+);/g;
  const categories: SwatchCategories = {};

  let match: RegExpExecArray | null;
  while ((match = variableRegex.exec(styleBlockContents)) !== null) {
    const name = match[1].trim(); // e.g. "color-primary-500"
    const value = match[2].trim(); // e.g. "hsl(210, 50%, 50%)"

    // Fallback to "uncategorized" if the variable name lacks a standard category prefix
    const nameParts = name.split("-");
    const category = nameParts.length > 1 ? nameParts[1] : "uncategorized";

    if (!categories[category]) {
      categories[category] = [];
    }

    categories[category].push({ name, value });
  }

  return categories;
}

// Extract variables from raw CSS string contents
const primarySwatches = extractCssVariables(primaryCss);
const secondarySwatches = extractCssVariables(secondaryCss);
const graySwatches = extractCssVariables(grayCss);

// Merge swatches safely
const swatches: SwatchCategories = {
  ...primarySwatches,
  ...secondarySwatches,
  ...graySwatches,
};

/**
 * Helper function to capitalize title words
 */
function toCapitals(str: string): string {
  return str
    .split(" ")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
}
---

<!-- Render swatches from palette.primary.css and palette.gray.css -->{
  Object.entries(swatches).map(([color, items]) => (
    <div>
      <h3 id={`color-palette-${color}`}>{toCapitals(color)}</h3>
      <ul role="list">
        {items.map(({ name }) => (
          <li>
            <item style={`--swatch-color: var(--${name})`} />
            <small>
              <code>{"--" + name}</code>
              {/* <small>{value}</small> */}
            </small>
          </li>
        ))}
      </ul>
    </div>
  ))
}

<style>
  div + div {
    margin-block-start: var(--spacing-xl);
  }
  item {
    background-color: var(--swatch-color);
    display: inline-block;
    width: 100%;
    aspect-ratio: 1;
    border: var(--border-width-hairline) solid var(--color-separator);
  }

  small {
    display: inline-block;
  }

  ul {
    margin-block-start: 1em;
    display: grid;
    gap: var(--spacing-xs);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 7ch), 1fr));
  }
</style>
