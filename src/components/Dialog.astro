<dialog id='dialog-basic'>
  <article>
    <header>
      <h2>Basic Dialog Title</h2>
      <button id="dialog-basic-close" aria-label='Close' autofocus></button>
    </header>
    <div>
      <p>Amet amet laboris tempor labore nostrud cupidatat ex aliqua non duis. Id deserunt elit reprehenderit. Ea consequat nisi in Lorem.</p>
      <p>Amet amet laboris tempor labore nostrud cupidatat ex aliqua non duis. Id deserunt elit reprehenderit. Ea consequat nisi in Lorem.</p>
    </div>
  </article>
</dialog>
<button id="dialog-basic-open">Open the Basic Dialog</button>

<script is:inline>
  const dialogBasic = document.getElementById("dialog-basic")
  const dialogBasicOpen = document.getElementById("dialog-basic-open")
  const dialogBasicClose = document.getElementById("dialog-basic-close")
  dialogBasicOpen.addEventListener("click", () => {
    dialogBasic.showModal()
  })
  dialogBasicClose.addEventListener("click", () => {
    dialogBasic.close()
  })
</script>
