---
const { ...restProps } = Astro.props
---

<h1 class="grid-stack" {...restProps}>
  <span class="word word-3b"></span>
  <span class="word word-3a"></span>

  <span class="word word-2b"></span>
  <span class="word word-2a"></span>

  <span class="word word-1b"></span>
  <span class="word word-1a"></span>

  <span class="word word-0"><span class="sr-only">SOL CSS</span></span>
  
</h1>

<style>
  [class*="word-"] {
    --_width: 500px;
    --_perspective: perspective(300px);
    --_translate: 0;
    block-size: auto;
    inline-size: var(--_width);
    max-inline-size: 100%;
    aspect-ratio: 500 / 155;
    background: var(--color-surface);
    /* border: 6px solid var(--color-surface); */
    padding: 0.25rem;
    position: relative;
    margin: auto;
    display: grid;
  }

  [class*="word-"]::before {
    --_color: currentColor;
  }

  [class^="word"]::before {
    background-color: var(--_color);
    content: "";
    height: 100%;
    width: 100%;
    display: block;
    mask-image: url("data:image/svg+xml, %3Csvg viewBox='0 0 518 160' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1.13335 45.6C1.33335 14.6 28.3334 0 81.7334 0C112.733 0 136.933 4.4 155.933 9L157.733 45.8C135.333 38.6 111.333 34.4 86.7334 34.4C61.9333 34.4 52.7333 38.8 52.7333 46.4C52.7333 71.6 165.933 43.2 165.933 109C165.933 142.2 137.333 159.6 86.5334 159.6C54.9334 159.6 27.1334 153.2 2.93335 143.2L0.93335 104C24.3334 116 51.1334 123 80.5334 123C104.133 123 113.733 118 113.733 110C113.733 83.4 0.93335 111.2 1.13335 45.6Z' fill='black'/%3E%3Cpath d='M267.718 159.6C206.518 159.6 171.918 128.6 171.918 80C171.918 31.6 206.518 0.600004 267.718 0.600004C328.918 0.600004 363.518 31.6 363.518 80C363.518 128.6 328.918 159.6 267.718 159.6ZM267.718 122C295.318 122 311.118 106.4 311.118 80C311.118 53.8 295.318 38.2 267.918 37.8C239.918 37.4 224.318 53 224.318 80C224.318 106.4 239.918 122 267.718 122Z' fill='black'/%3E%3Cpath d='M374.605 155V5H423.605V117.6H517.605V155H374.605Z' fill='black'/%3E%3C/svg%3E");
    mask-repeat: no-repeat;
    mask-size: contain;
    mask-position: 50% 50%;
    margin: auto;
  }

  [class$="a"] {
    transform: var(--_perspective) translate3d(0, calc(-1 * var(--_translate)), calc(-1 * var(--_translate)));
  }

  [class$="b"] {
    transform: var(--_perspective) translate3d(0, var(--_translate), calc(-1 * var(--_translate)));
  }

  .word-0 {
    transform: var(--_perspective) translate3d(0, 0, 0);
  }


  .word-1a::before,
  .word-1b::before {
    --_color: var(--color-accent);
  }
  .word-1a, .word-1b {
    --_translate: 25px;
  }


  .word-2a::before,
  .word-2b::before {
    --_color: color-mix(in oklch, var(--color-accent), transparent 25%);
  }
  .word-2a, .word-2b {
    --_translate: 50px;
  }


  .word-3a::before,
  .word-3b::before {
    --_color: color-mix(in oklch, var(--color-accent), transparent 50%);
  }
  .word-3a, .word-3b {
    --_translate: 75px;
  }


  .grid-stack {
    aspect-ratio: 500 / 250;
    height: auto;
      width: 500px;
      max-width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-inline: auto;

    > * {
      grid-column: 1;
      grid-row: 1;
      
    }
  }
</style>
