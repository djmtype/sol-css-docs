---
import { getEntry } from "astro:content";

type Props = {
  currentPage: string;
};

const { currentPage } = Astro.props;

const navPrimaryData = await getEntry("navPrimary", "primary-navigation");

const navPrimary = navPrimaryData.data

---

<nav aria-labelledby={navPrimary.name} id={navPrimary.id}>
  <ul role="list">
    {navPrimary.links.map((link) => (
      <li>
        <a 
          href={link.url}
          target={link.external ? "_blank" : "_self"}
          rel={link.external ? "noopener noreferrer" : undefined}
          aria-current={currentPage === link.url ? "page" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>


