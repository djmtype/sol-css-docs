---
import { type CollectionEntry, getCollection } from "astro:content";

type Props = {
  currentPage: string;
};

const { currentPage } = Astro.props;

const mainNavigationData = await getCollection("mainNavigation");
const mainNav = mainNavigationData[0]?.data;
---

<nav aria-labelledby={mainNav.id}>
  <ul role="list">
    {mainNav.links.map((link) => (
      <li>
        <a 
          href={link.url}
          target={link.external ? "_blank" : "_self"}
          rel={link.external ? "noopener noreferrer" : undefined}
          aria-current={currentPage === link.url ? "page" : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
