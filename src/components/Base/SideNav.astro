---
import { getCollection, type CollectionEntry } from "astro:content"

const categoryOrder = ["getting-started", "elements", "components"] as const
const currentPage = new URL(Astro.request.url).pathname

// Fetch and organize docs in a single pass
const navData = (await getCollection("docs"))
  .filter((entry) => entry.data.draft !== true)
  .reduce(
    (acc, entry) => {
      const { category } = entry.data
      if (!acc[category]) acc[category] = []
      acc[category].push(entry)
      return acc
    },
    {} as Record<string, CollectionEntry<"docs">[]>,
  )

// Sort categories and their contents in one go
const sortedNavData = categoryOrder.filter((category) => navData[category]?.length > 0).map((category) => [category, navData[category].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))]) as [string, CollectionEntry<"docs">[]][]

// Memoize the path creation
const getItemPath = (item: CollectionEntry<"docs">) => `/${item.collection}/${item.id}`

// Helper function for checking if a category should be open
const isCategoryOpen = (items: CollectionEntry<"docs">[]) => items.some((item) => getItemPath(item) === currentPage)


const titleCase = (category: string) => 
    category
        .replace(/-/g, " ")             // Replace hyphens with spaces
        .toLowerCase()                  // Convert to lowercase first
        .replace(/\b\w/g, (char) => char.toUpperCase()); 
---

<nav aria-label="Documentation Navigation">
  {
    sortedNavData.map(([category, items]) => (
      <details open={isCategoryOpen(items)}>
        <summary>{titleCase(category)}</summary>
        <div>
          <ul role="list">
            {items.map((item) => {
              const path = getItemPath(item)
              return (
                <li data-item={category}>
                  <a href={path} aria-current={path === currentPage ? "page" : undefined}>
                    {item.data.title}
                  </a>
                </li>
              )
            })}
          </ul>
        </div>
      </details>
    ))
  }
</nav>
