---
import MainNav from "@/components/Base/MainNav.astro"
import Logo from "@/components/Base/Logo.astro"

type Props = {
  currentPage: string
}

const { currentPage } = Astro.props
---

<header>
  <div>
    <a href="/">
    <Logo style={{ blockSize: '2rem', inlineSize: 'auto' }} />
    <span class="sr-only">SOL CSS</span>
    </a>
    <MainNav currentPage={currentPage} />
  </div>
</header>
