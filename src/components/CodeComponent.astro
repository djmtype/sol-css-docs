---
import type { LanguageRegistration, SpecialLanguage, ThemeRegistration, ThemeRegistrationRaw } from "@shikijs/types"
import { v4 as uuidv4 } from "uuid"
import { Code } from "astro/components"
const html = await Astro.slots.render("default")
const uuid = uuidv4()

type Props = {
  code?: string
  file?: any
  style?: any
  theme: ThemeRegistration | ThemeRegistrationRaw
  class?: string
  open?: boolean
  wrap?: boolean | null
  summary?: string
  pathName?: string
  lang?: SpecialLanguage | LanguageRegistration
  clipboardLabel?: string
  clipboardNotice?: string
  stage?: boolean
}

const { code, file, lang = "html", theme = "css-variables", summary = "HTML", pathName, open, wrap = false, clipboardLabel = "Copy to clipboard", clipboardNotice = "Copied!", class: className, stage = true, ...restProps } = Astro.props as Props

---

<div class:list={[
  stage ? 'stage' : undefined,
  className ? className : undefined
]} {...restProps}><Fragment set:html={code} /></div>

<details open={open ? true : undefined}>
  <summary>{summary}</summary>
  <div>
    {pathName && <code class="path">{pathName}</code>}
    <Code id={`component-${uuid}`} code={code || file || html} lang={lang} theme={theme} wrap={wrap} />
    <clipboard-copy for={`component-${uuid}`}>
      <span aria-label={clipboardLabel}>
        <svg xmlns="http://www.w3.org/2000/svg" focusable="false" aria-hidden="true" width="32" height="32" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" vector-effect="non-scaling-stroke"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path></g></svg>
      </span>
      <span class="notice" hidden>{clipboardNotice}</span>
    </clipboard-copy>
  </div>
</details>

<script>
  import "@github/clipboard-copy-element"
</script>

<script is:inline>
  document.addEventListener("clipboard-copy", function (event) {
    const notice = event.target.querySelector(".notice")
    announce.setAttribute("aria-label", "Copied")
    notice.hidden = false
    setTimeout(function () {
      announce.setAttribute("aria-label", "")
      notice.hidden = true
    }, 1000)
  })
</script>

<style>
  .stage {
    border: var(--border-width-default) solid var(--color-separator);
    /* background-color: var(--color-surface-dim); */
    padding: var(--spacing-gutter);
    border-radius: var(--radius-default);
    display: grid;
    /* place-content: center; */
  }

  .stage + details {
--_flow: var(--spacing-sibling);
  }
  pre {
    margin: 0;
  }
  pre + [role="button"] {
    position: absolute;
    margin: 0;
    top: var(--spacing-4xs);
    right: var(--spacing-4xs);
    font-size: var(--font-size-00);
    padding: var(--spacing-button-block);
    gap: 0.5em;
  }

  pre + [role="button"] svg {
    width: 1.25em;
    height: 1.25em;
  }
  pre + [role="button"] > span:not([hidden]) {
    display: inline-flex;
  }
</style>

<style is:global>
  details:has(pre) > div {
    padding: 0;
    position: relative;
  }

  * + .panel + details {
    margin-block-start: var(--spacing-2xl);
  }
</style>
