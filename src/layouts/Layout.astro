---
// import 'sol-css/src/sol.css'
import "@/styles/main.css"
import type { MarkdownHeading } from "astro"
import type { CollectionEntry } from "astro:content"


import BaseHead from "@/components/Base/Head.astro"
import SkipLink from "@/components/Base/SkipLink.astro"
import BaseHeader from "@/components/Base/Header.astro"


type PagesCollectionProps = CollectionEntry<"pages">["data"]
type DocsCollectionProps = CollectionEntry<"docs">["data"]
type BaseHeadProps = {
  headings?: MarkdownHeading[]
  title: string
  description?: string
}

type Props = (PagesCollectionProps | DocsCollectionProps) & BaseHeadProps;



const currentPage = Astro.url.pathname
const { title, description, headings, ...data } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<html dir='ltr' lang='en-us'>
  <head>
    <BaseHead title={title ? title : "SOL | CSS without the FUSS"} description={description ? description : "A drop-in classless style library"} canonicalUrl={canonicalURL} {...data} />
  </head>

  <body>
    <SkipLink />
    <!-- <button id="themeToggle">Toggle</button> -->
    <BaseHeader currentPage={currentPage} />
    <div aria-live='polite' id='announce'></div>
    <main id='main-content'>
      <slot />
    </main>
    <footer id="colophon">
      <p style="font-size: var(--font-size-00)">&copy; 2024 SOL system. <a href="/license" target="_blank" rel="noopener">MIT License</a>.</p>
    </footer>
  </body>
</html>

<script is:inline>
  // Wait for the DOM content to be fully loaded
document.addEventListener("DOMContentLoaded", () => {
  // Get the header element
  const header = document.querySelector("body > header");

  if (header) {
    // Get the height of the header element
    const headerHeight = header.offsetHeight;

    // Set the CSS custom property --header-height to the header height in pixels
    document.documentElement.style.setProperty("--header-height", `${headerHeight}px`);
  }
});


// Function to calculate the greatest common divisor (GCD)
function gcd(a, b) {
    return b === 0 ? a : gcd(b, a % b);
}

// Function to update the aspect ratio CSS custom property
function updateAspectRatio() {
    const width = window.innerWidth;
    const height = window.innerHeight;

    // Calculate the GCD to simplify the ratio
    const divisor = gcd(width, height);
    const aspectRatioWidth = width / divisor;
    const aspectRatioHeight = height / divisor;

    // Create the aspect ratio string in the format 'width/height'
    const aspectRatio = `${aspectRatioWidth}/${aspectRatioHeight}`;

    // Set the aspect ratio as a CSS custom property
    document.documentElement.style.setProperty('--aspect-ratio', aspectRatio);
}

// Create a ResizeObserver to watch for window size changes
const resizeObserver = new ResizeObserver(() => {
    updateAspectRatio();
});

// Observe the document's root element (or any other element you want)
resizeObserver.observe(document.documentElement);

// Initial call to set the aspect ratio on page load
updateAspectRatio();



</script>


