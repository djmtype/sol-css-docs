---
// import 'sol-css/src/sol.css'
import "@/styles/main.css"

import type { MarkdownLayoutProps } from 'astro';

import BaseHead from "@/components/Base/Head.astro"
import SkipLink from "@/components/Base/SkipLink.astro"
import BaseHeader from "@/components/Base/Header.astro"


type Props = MarkdownLayoutProps<{
  title: string;
  description: string;
  // category: string;
}>



const currentPage = Astro.url.pathname
const { frontmatter } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<html dir='ltr' lang='en-us'>
  <head>
    <BaseHead title={frontmatter && frontmatter.title || "Default Title"} description={frontmatter && frontmatter.description || "Default Description"} canonicalUrl={canonicalURL} category="" />
  </head>

  <body>
    <SkipLink />
    <!-- <button id="themeToggle">Toggle</button> -->
    <BaseHeader currentPage={currentPage} />
    <div aria-live='polite' id='announce'></div>
    <main id='main-content'>
      <slot />
    </main>
    <footer id="colophon">
      <p style="font-size: var(--font-size-00)">&copy; 2024 SOL system. <a href="/license" target="_blank" rel="noopener">MIT License</a>.</p>
    </footer>
  </body>
</html>

